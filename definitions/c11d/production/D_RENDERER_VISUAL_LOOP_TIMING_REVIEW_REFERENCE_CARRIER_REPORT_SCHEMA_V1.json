        "renderer_baseline_frozen": {
          "const": false
        },
        "godot_invoked": {
          "const": false
        },
        "request_persisted": {
          "const": false
        },
        "payload_materialized": {
          "const": false
        },
        "renderer_native_input_emitted": {
          "const": false
        },
        "renderer_dispatch_invoked": {
          "const": false
        },
        "media_created": {
          "const": false
        },
        "c11c_source_mutation": {
          "const": false
        },
        "renderer": {
          "const": "OFF"
