    "schema_version",
    "status",
    "contract_sha256",
    "source_lineage",
    "envelopes",
    "summary",
    "governance",
    "report_sha256"
  ],
  "properties": {
    "schema": {
      "const": "C11-D-VISUAL-LOOP-TIMING-REVIEW-REFERENCE-CARRIER-REPORT-V1"
