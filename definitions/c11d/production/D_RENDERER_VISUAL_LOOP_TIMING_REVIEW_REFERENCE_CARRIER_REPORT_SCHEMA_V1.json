{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c11d:visual-loop-timing-review-reference-carrier-report:v1",
  "title": "C11-D Visual Loop Timing/Review Reference Carrier Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
