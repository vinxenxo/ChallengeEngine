        "D4.8": {
          "const": "BLOCKED"
        },
        "release_authority": {
          "const": "NONE"
        },
        "D9.10": {
          "const": "PREPARE_ONLY"
        },
        "D9.17": {
          "const": "BLOCKED_NO_GO"
        }
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
