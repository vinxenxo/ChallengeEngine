          },
          "shared_reference_set_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selector_envelope_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "policy_source_bodies_copied": {
            "const": false
          },
          "policy_values_copied": {
            "const": false
          },
          "renderer_instructions_emitted": {
            "const": false
          },
          "canonical_request_modified": {
            "const": false
          },
          "canonical_payload_modified": {
            "const": false
          },
          "request_bound": {
            "const": false
          },
          "payload_materialized": {
            "const": false
          },
          "renderer_native_input_emitted": {
            "const": false
          },
          "canonical_binding_admitted": {
            "const": false
          },
          "policy_approval_state": {
            "const": "UNAPPROVED_PROPOSALS_REFERENCE_ONLY"
          }
        }
      }
