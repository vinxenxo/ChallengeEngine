          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "envelopes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "schema_version",
          "mode",
          "selection",
          "policy_references",
          "shared_reference_set_sha256",
          "selector_envelope_sha256",
          "policy_source_bodies_copied",
          "policy_values_copied",
