          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content_type",
              "family_id",
              "grammar_id",
              "grammar_index",
              "shader_branch"
            ],
            "properties": {
              "content_type": {
                "const": "visual_loops"
              },
              "family_id": {
                "const": "c11c_geometric_waves_v1"
              },
              "grammar_id": {
                "enum": [
                  "harmonic_membrane",
                  "interference_plane",
                  "parametric_ribbon",
                  "lattice_wave",
                  "orbital_wave"
                ]
              },
              "grammar_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "shader_branch": {
                "type": "string"
              }
            }
          },
          "policy_references": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "path",
                "sha256",
                "expected_status",
                "scope",
                "approval_assertion_count",
                "all_approval_assertions_false",
                "reference_role"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "expected_status": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "approval_assertion_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "all_approval_assertions_false": {
                  "const": true
                },
                "reference_role": {
                  "const": "PROVENANCE_ONLY_NOT_INSTRUCTIONS"
