      "properties": {
        "direct_source_pins": {
          "const": "16/16"
        },
        "selectors": {
          "const": 5
        },
        "policy_refs_per_selector": {
          "const": 9
        },
        "reference_descriptors": {
          "const": 45
        },
        "prepared_envelopes": {
          "const": "5/5"
        },
        "shared_reference_set_digest_unique_count": {
          "const": 1
        },
        "selector_envelope_digest_unique_count": {
          "const": "5/5"
        },
        "canonical_binding_review": {
          "const": "1/5"
        },
        "blocked_by_fixed_v1_scope": {
          "const": "4/4"
        },
        "approval_assertions_checked": {
          "const": 19
        },
        "approvals_granted": {
          "const": 0
        },
        "candidate_input_admissible": {
          "const": false
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing_review_inheritance_approved",
        "canonical_request_selector_matrix_approved",
        "exact_selector_payload_approved",
        "shared_policy_approved",
        "renderer_baseline_approved",
        "renderer_baseline_frozen",
        "godot_invoked",
        "request_persisted",
        "payload_materialized",
        "renderer_native_input_emitted",
        "renderer_dispatch_invoked",
        "media_created",
        "c11c_source_mutation",
        "renderer",
        "D4.8",
        "release_authority",
        "D9.10",
        "D9.17"
      ],
