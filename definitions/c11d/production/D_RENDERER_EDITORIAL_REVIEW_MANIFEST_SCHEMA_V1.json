{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c11d:renderer-editorial-review-manifest:v1",
  "title": "C11-D Renderer Editorial Review Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "frozen_c11c_manifest_sha256",
    "content_type",
    "review_identity",
    "source_identity",
    "delivery_target",
    "temporal_reference",
    "editorial_fields",
    "review_assessment",
    "execution_boundary",
    "review_manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "C11-D-D9-RENDERER-EDITORIAL-REVIEW-MANIFEST-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "PREPARATION_ONLY_EDITORIAL_REVIEW_MANIFEST_WITH_OPEN_RENDER_BINDINGS"
    },
    "content_type": {
      "enum": [
        "challenges",
        "visual_loops",
        "visual_drills"
      ]
    },
    "review_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "variant_scope_id",
        "selection",
        "editorial_value_count",
        "human_copy_review_permitted"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "object"
        },
        "editorial_value_count": {
          "type": "integer",
          "minimum": 1
        },
        "human_copy_review_permitted": {
          "const": true
        }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_hash",
        "editorial_hash",
        "plan_hash",
        "bridge_record_hash",
        "adapter_envelope_hash",
        "binding_preview_sha256",
        "composition_sha256",
        "frame_program_sha256",
        "temporal_preview_sha256",
        "frozen_c11c_manifest_sha256",
        "review_contract_sha256",
        "review_schema_sha256",
        "review_implementation_sha256",
        "source_lineage_sha256"
      ],
      "properties": {
        "request_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "editorial_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bridge_record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_envelope_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding_preview_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "composition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frame_program_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "temporal_preview_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frozen_c11c_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_implementation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_lineage_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "delivery_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_profile_id",
        "resolved_profile_id",
        "width",
        "height",
        "fps",
        "profile_registry_sha256",
        "metadata_only"
      ],
      "properties": {
        "requested_profile_id": {
          "type": "string"
        },
        "resolved_profile_id": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "profile_registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata_only": {
          "const": true
        }
      }
    },
    "temporal_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_scope",
        "source_path",
        "source_id",
        "source_sha256",
        "source_fps",
        "source_duration_seconds",
        "total_frames",
        "segments",
        "fps_alignment",
        "per_field_visibility_windows_defined",
        "per_field_frame_ranges",
        "selection_specific_visual_payload_bound"
      ],
      "properties": {
        "source_scope": {
          "enum": [
            "EXACT_CHALLENGE_VARIANT_SOURCE",
            "FAMILY_LEVEL_TIMING_REFERENCE_GRAMMAR_INSTANCE_NOT_BOUND",
            "DRILL_TYPE_AND_TIER_TIMING_REFERENCE_GENERATED_PAYLOAD_INSTANCE_NOT_BOUND"
          ]
        },
        "source_path": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_fps": {
          "type": "integer",
          "minimum": 1
        },
        "source_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "start_frame",
              "end_frame_exclusive",
              "frame_count",
              "source_duration_seconds"
            ],
            "properties": {
              "segment_id": {
                "type": "string"
              },
              "start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "end_frame_exclusive": {
                "type": "integer",
                "minimum": 1
              },
              "frame_count": {
                "type": "integer",
                "minimum": 1
              },
              "source_duration_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "fps_alignment": {
          "enum": [
            "MATCH_FOR_REFERENCE_ONLY",
            "MISMATCH_REQUIRES_EXPLICIT_NORMALIZATION"
          ]
        },
        "per_field_visibility_windows_defined": {
          "const": false
        },
        "per_field_frame_ranges": {
          "type": "null"
        },
        "selection_specific_visual_payload_bound": {
          "const": false
        }
      }
    },
    "editorial_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id",
          "source_field",
          "text_value",
          "text_sha256",
          "language",
          "semantic_region_id",
          "target_mapping_state",
          "layout_binding_state",
          "temporal_binding_state",
          "visibility_frame_range"
        ],
        "properties": {
          "element_id": {
            "type": "string"
          },
          "source_field": {
            "type": "string"
          },
          "text_value": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "semantic_region_id": {
            "type": "string"
          },
          "target_mapping_state": {
            "const": "PROPOSED_NOT_APPROVED"
          },
          "layout_binding_state": {
            "const": "UNRESOLVED_NO_COORDINATES"
          },
          "temporal_binding_state": {
            "const": "NOT_SCHEDULED_NO_FRAME_RANGE"
          },
          "visibility_frame_range": {
            "type": "null"
          }
        }
      }
    },
    "review_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_editorial_parity",
        "upstream_chain_parity",
        "temporal_source_alignment",
        "delivery_fps_reconciliation",
        "field_visibility_policy",
        "editorial_review_status",
        "video_render_ready"
      ],
      "properties": {
        "canonical_editorial_parity": {
          "const": "PASS"
        },
        "upstream_chain_parity": {
          "const": "PASS"
        },
        "temporal_source_alignment": {
          "enum": [
            "EXACT_CHALLENGE_ID",
            "FAMILY_LEVEL_REFERENCE_ONLY",
            "TYPE_AND_TIER_REFERENCE_ONLY"
          ]
        },
        "delivery_fps_reconciliation": {
          "enum": [
            "MATCH_REFERENCE_ONLY",
            "REQUIRES_EXPLICIT_NORMALIZATION_POLICY"
          ]
        },
        "field_visibility_policy": {
          "const": "UNRESOLVED_NO_PER_FIELD_FRAME_WINDOWS"
        },
        "editorial_review_status": {
          "const": "HUMAN_COPY_REVIEWABLE_WITH_OPEN_RENDER_BINDINGS"
        },
        "video_render_ready": {
          "const": false
        }
      }
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_mode",
        "renderer_native_input_emitted",
        "renderer_dispatch_invoked",
        "renderer_activation",
        "production_execution",
        "media_output_created",
        "output_artifact_path",
        "d4_8",
        "release_authority",
        "c11c_source_mutation",
        "video_render_ready"
      ],
      "properties": {
        "review_mode": {
          "const": "IN_MEMORY_EDITORIAL_CHAIN_AUDIT"
        },
        "renderer_native_input_emitted": {
          "const": false
        },
        "renderer_dispatch_invoked": {
          "const": false
        },
        "renderer_activation": {
          "const": false
        },
        "production_execution": {
          "const": false
        },
        "media_output_created": {
          "const": false
        },
        "output_artifact_path": {
          "type": "null"
        },
        "d4_8": {
          "const": "BLOCKED"
        },
        "release_authority": {
          "const": "NONE"
        },
        "c11c_source_mutation": {
          "const": false
        },
        "video_render_ready": {
          "const": false
        }
      }
    },
    "review_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frozen_c11c_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
