    "language": "METADATA_NOT_DISPLAY_TEXT",
    "challenge_fields": "CHALLENGES_ONLY_PLAYER_NAME_AND_CHALLENGE_LABEL",
    "family_adapter_mutation": "FORBIDDEN",
    "inheritance_default": "SHARED_EDITORIAL_AND_PRESENTATION"
  },
  "governance": {
    "renderer_activation": false,
    "production_execution": false,
    "media_created": false,
    "c11c_source_mutation": false,
    "d4_8": "BLOCKED",
