  "composition_rules": {
    "text_binding": "Every required non-language editorial value is copied exactly into an element.text_value; that property is part of the logical composition payload, not merely provenance metadata.",
    "language_binding": "The canonical language value is attached to every text element and exposed as composition localization.locale.",
    "ordering": "Order text elements by ascending z_order, then element_id; do not rely on dict iteration or hash order.",
    "geometry": "Only resolved delivery geometry and frame-rate identity are copied. No pixel coordinates, shader IDs, renderer resource paths, frame timeline or engine-native command is emitted.",
    "content_identity": "Copy only canonical selection identity from the source preview; do not bind simulation truth or derived telemetry.",
    "seed_isolation": "Preserve domain rules as metadata only. This composition has no seed-dependent visual or audio behavior.",
    "determinism": "Canonical JSON SHA-256; no timestamp, random ID, environment path or process details in the plan hash."
  },
  "forbidden_operations": [
    "emit renderer-native input",
    "write plan or media files",
    "invoke or dispatch a renderer",
    "launch Godot or FFmpeg",
    "produce video, image, audio or other media",
    "bind SimulationResult, winning_frame, close_calls or derived telemetry",
    "derive or auto-generate seeds",
    "modify C11-C source or its freeze manifest",
    "change D4.8, release authority or any activation policy"
  ],
