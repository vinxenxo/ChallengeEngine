  "proof_rules": [
    {
      "id": "REQUEST_PLAN_IDENTITY_REPEAT",
      "condition": "Base R1 and R2 request_hash and plan_hash must be equal; their process IDs and run IDs must differ."
    },
    {
      "id": "PROJECTION_REPEAT",
      "condition": "Base R1 and R2 safe_projection_state_sha256 and each per-field candidate probe hash must match."
    },
    {
      "id": "GAMEPLAY_SEED_SENSITIVITY",
      "condition": "For every selector the safe_projection_state_sha256 for GAMEPLAY_SEED_MUTATION must differ from Base R1. This is output-state evidence, not request/plan hash evidence."
    },
    {
      "id": "MUSIC_ORTHOGONALITY",
      "condition": "MUSIC_SEED_MUTATION may change request/plan identity, but the safe_projection_state_sha256 and allowlisted candidate field hashes must match Base R1."
    },
    {
      "id": "EDITORIAL_INVARIANCE",
      "condition": "EDITORIAL_MUTATION changes editorial/request identity but preserves safe projection and candidate field hashes; challenge simulation input hash must match Base R1."
    },
    {
      "id": "PILOT_TARGET_X_EXCEPTION",
      "condition": "CHALLENGE_003 target_x candidate hash is expected invariant across gameplay-seed mutation; never use target_x alone as seed-sensitivity oracle."
    },
    {
      "id": "TEMPORAL_CONFLICT",
      "condition": "CHALLENGE_008 and CHALLENGE_009 are source-frame-only; no phase/timeline acceptance."
    }
  ],
