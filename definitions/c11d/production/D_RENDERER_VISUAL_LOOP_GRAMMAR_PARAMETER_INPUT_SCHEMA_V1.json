{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c11d:visual-loop-grammar-parameter-input:v1",
  "title": "Canonical request-bound input for grammar parameter instance probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "contract_sha256",
    "frozen_c11c_manifest_sha256",
    "request",
    "canonical_chain"
  ],
  "properties": {
    "schema": {
      "const": "C11-D-D9-VISUAL-LOOP-GRAMMAR-PARAMETER-INPUT-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frozen_c11c_manifest_sha256": {
      "const": "e405d08e4d166b1ad95953558f4a088e73eea9527e6e89244beb4096eac4b953"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "request_id",
        "request_hash",
        "selection",
        "seed",
        "music_seed",
        "variation_index",
        "presentation_profile_id",
        "delivery_profile_id"
      ],
      "properties": {
        "schema": {
          "const": "C11-D-D9-DYNAMIC-REQUEST-PAYLOAD-INPUT-V1"
        },
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_type",
            "family_id",
            "subtype_id",
            "variant_id"
          ],
          "properties": {
            "content_type": {
              "const": "visual_loops"
            },
            "family_id": {
              "const": "c11c_geometric_waves_v1"
            },
            "subtype_id": {
              "const": "harmonic_membrane"
            },
            "variant_id": {
              "type": "null"
            }
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "music_seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "variation_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "presentation_profile_id": {
          "const": "social_default_v1"
        },
        "delivery_profile_id": {
          "enum": [
            "REVIEW_720",
            "MIN_540",
            "MASTER_1080",
            "META_REELS_FINAL_V1"
          ]
        }
      }
    },
    "canonical_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_hash",
        "editorial_hash",
        "bridge_record_hash",
        "adapter_envelope_hash",
        "source_binding_sha256"
      ],
      "properties": {
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "editorial_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bridge_record_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_envelope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
