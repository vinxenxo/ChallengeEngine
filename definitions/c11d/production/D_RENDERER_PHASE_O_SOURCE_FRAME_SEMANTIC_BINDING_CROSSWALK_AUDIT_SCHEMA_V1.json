    "selector_crosswalk": {"type": "array", "minItems": 9, "maxItems": 9},
    "field_crosswalk": {"type": "array", "minItems": 70},
    "temporal_policy_fields": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "object"}
    },
    "editorial_sidecar_inventory": {"type": "array", "minItems": 14, "maxItems": 14},
    "timebase_conflicts": {"type": "array", "minItems": 2, "maxItems": 2},
    "asset_source_pins": {"type": "array", "minItems": 3},
    "process_evidence_sha256": {"type": "object", "minProperties": 36, "maxProperties": 36},
    "invariants": {"type": "object"},
    "governance_locks": {"type": "object"},
    "next_safe_increment": {"type": "string"}
