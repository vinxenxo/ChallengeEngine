{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c11d:phase-o-source-frame-semantic-binding-crosswalk-audit-report:v1",
  "title": "C11-D Phase O source-frame to semantic binding crosswalk audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "generated_utc",
    "scope",
    "input_evidence",
    "source_pins",
    "summary",
    "selector_crosswalk",
    "field_crosswalk",
    "temporal_policy_fields",
    "editorial_sidecar_inventory",
    "timebase_conflicts",
    "asset_source_pins",
    "process_evidence_sha256",
    "invariants",
    "governance_locks",
    "next_safe_increment"
