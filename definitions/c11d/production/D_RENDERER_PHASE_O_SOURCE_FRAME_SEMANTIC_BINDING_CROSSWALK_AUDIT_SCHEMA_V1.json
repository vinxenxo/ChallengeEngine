    "input_evidence": {"type": "object"},
    "source_pins": {"type": "object", "minProperties": 10},
    "summary": {
      "type": "object",
      "required": [
        "selectors_verified", "runtime_receipts_verified", "process_evidence_files_verified",
        "asset_source_pins_verified", "base_frame_field_rows", "stable_custom_data_candidate_occurrences",
        "static_source_pointers_present", "timebase_conflicts_unresolved", "challenge_editorial_sidecar_fields",
        "editorial_sidecar_slots_across_all_content_types", "approved_bindings",
        "approved_custom_data_bindings", "approved_renderer_projection_bindings",
        "editorial_fields_visually_consumed", "custom_data_values_serialized", "renderer", "media_created",
        "payload_materialized", "candidate_input_admissible", "release_authority"
      ],
      "properties": {
        "selectors_verified": {"const": 9},
        "runtime_receipts_verified": {"const": 18},
        "process_evidence_files_verified": {"const": 36},
        "base_frame_field_rows": {"const": 54},
        "stable_custom_data_candidate_occurrences": {"const": "6/6"},
        "static_source_pointers_present": {"const": "3/3"},
        "timebase_conflicts_unresolved": {"const": 2},
        "challenge_editorial_sidecar_fields": {"const": 6},
        "editorial_sidecar_slots_across_all_content_types": {"const": 14},
        "approved_bindings": {"const": 0},
        "approved_custom_data_bindings": {"const": 0},
        "approved_renderer_projection_bindings": {"const": 0},
        "editorial_fields_visually_consumed": {"const": 0},
        "custom_data_values_serialized": {"const": false},
        "renderer": {"const": "OFF"},
        "media_created": {"const": false},
        "payload_materialized": {"const": false},
        "candidate_input_admissible": {"const": false},
        "release_authority": {"const": "NONE"}
      }
