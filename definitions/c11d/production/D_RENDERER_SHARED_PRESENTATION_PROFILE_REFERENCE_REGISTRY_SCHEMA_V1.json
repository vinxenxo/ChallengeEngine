{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "C11-D-D9-SHARED-PRESENTATION-PROFILE-REFERENCE-REGISTRY-SCHEMA-V1",
  "title": "C11-D Shared Presentation Profile Reference Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "default_profile_id",
    "registration_policy",
    "profiles",
    "source_lineage",
    "governance"
  ],
  "properties": {
    "schema": {
      "const": "C11-D-D9-SHARED-PRESENTATION-PROFILE-REFERENCE-REGISTRY-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "REFERENCE_IDENTITY_ONLY_NOT_PHYSICAL_BINDING"
    },
    "default_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "registration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_profile",
        "profile_addition",
        "geometry_authority",
        "family_exception_policy"
      ],
      "properties": {
        "unknown_profile": {
          "const": "REJECT"
        },
        "profile_addition": {
          "const": "EXPLICIT_VERSIONED_HASH_BOUND_REGISTRY_CHANGE"
        },
        "geometry_authority": {
          "const": "NOT_DEFINED_BY_THIS_REGISTRY"
        },
        "family_exception_policy": {
          "const": "SEPARATE_HASH_BOUND_APPROVAL_REQUIRED"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "identity_source",
          "identity_token",
          "status",
          "default",
          "eligible_content_types",
          "geometry_state",
          "render_ready"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "identity_source": {
            "type": "string",
            "const": "core/presentation/PresentationProfile.gd"
          },
          "identity_token": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "REGISTERED_REFERENCE_ONLY"
          },
          "default": {
            "type": "boolean"
          },
          "eligible_content_types": {
            "type": "array",
            "items": {
              "enum": [
                "challenges",
                "visual_loops",
                "visual_drills"
              ]
            },
            "uniqueItems": true,
            "minItems": 3,
            "maxItems": 3
          },
          "geometry_state": {
            "const": "NOT_RESOLVED_BY_IDENTITY_REGISTRY"
          },
          "render_ready": {
            "const": false
          }
        }
      }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_activation",
        "production_execution",
        "media_created",
        "d4_8",
        "release_authority",
        "c11c_source_mutation"
      ],
      "properties": {
        "renderer_activation": {
          "const": false
        },
        "production_execution": {
          "const": false
        },
        "media_created": {
          "const": false
        },
        "d4_8": {
          "const": "BLOCKED"
        },
        "release_authority": {
          "const": "NONE"
        },
        "c11c_source_mutation": {
          "const": false
        }
      }
    }
  }
}
