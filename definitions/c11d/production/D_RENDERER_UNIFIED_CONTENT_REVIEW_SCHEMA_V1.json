{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://challengeengine.local/schemas/c11d/d-renderer-unified-content-review-v1.json",
  "title": "C11-D Unified Content Review Manifest V1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "status",
    "frozen_c11c_manifest_sha256",
    "content_items",
    "harness_evidence",
    "cross_artifact_checks",
    "unresolved_gates",
    "execution_boundary",
    "review_manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "C11-D-D9-RENDERER-UNIFIED-CONTENT-REVIEW-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "REVIEW_CHAIN_CONSISTENT_NOT_VIDEO_READY"
    },
    "frozen_c11c_manifest_sha256": {
      "const": "e405d08e4d166b1ad95953558f4a088e73eea9527e6e89244beb4096eac4b953"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_lineage": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 15
    },
    "content_items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "content_type",
          "selection",
          "identity",
          "timing",
          "editorial_review",
          "materialization"
        ],
        "properties": {
          "content_type": {
            "enum": [
              "visual_loops",
              "visual_drills",
              "challenges"
            ]
          },
          "selection": {
            "type": "object"
          },
          "identity": {
            "type": "object"
          },
          "timing": {
            "type": "object"
          },
          "editorial_review": {
            "type": "object"
          },
          "materialization": {
            "type": "string"
          },
          "sample_selection": {
            "type": "object",
            "required": [
              "policy_id",
              "state",
              "proposal_contract_sha256",
              "preview_sha256",
              "source_snapshot_count",
              "delivery_snapshot_count",
              "stride",
              "sampling_origin",
              "first_source_snapshot_index",
              "last_source_snapshot_index",
              "interpolation",
              "winning_frame_local_game_index",
              "winning_frame_absolute_source_index",
              "winning_delivery_game_frame_index",
              "winning_absolute_delivery_frame_index",
              "anchor_mapping_status",
              "close_calls_count",
              "close_calls_used_for_timing",
              "renderer_native_input_emitted"
            ],
            "properties": {
              "policy_id": {
                "const": "C11D_CHALLENGE_SAMPLE_EVERY_SECOND_SOURCE_SNAPSHOT_NO_INTERPOLATION_V1"
              },
              "state": {
                "const": "PROPOSED_NOT_APPROVED"
              },
              "proposal_contract_sha256": {
                "const": "3e278481afe9d66458f05f29c15275819af49f9b68120b6a0b39dda2e9715cf3"
              },
              "preview_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_snapshot_count": {
                "const": 420
              },
              "delivery_snapshot_count": {
                "const": 210
              },
              "stride": {
                "const": 2
              },
              "sampling_origin": {
                "const": "ZERO_BASED_GAME_SEGMENT_LOCAL_INDEX"
              },
              "first_source_snapshot_index": {
                "const": 0
              },
              "last_source_snapshot_index": {
                "const": 418
              },
              "interpolation": {
                "const": "NONE"
              },
              "winning_frame_local_game_index": {
                "const": 394
              },
              "winning_frame_absolute_source_index": {
                "const": 574
              },
              "winning_delivery_game_frame_index": {
                "const": 197
              },
              "winning_absolute_delivery_frame_index": {
                "const": 287
              },
              "anchor_mapping_status": {
                "const": "EXACT_SELECTED_SAMPLE_AND_DELIVERY_TICK"
              },
              "close_calls_count": {
                "const": 1
              },
              "close_calls_used_for_timing": {
                "const": false
              },
              "renderer_native_input_emitted": {
                "const": false
              }
            },
            "additionalProperties": false
          },
          "coordinate_sample_composition": {
            "type": "object",
            "required": [
              "state",
              "proposal_contract_sha256",
              "coordinate_projection_policy_id",
              "sample_selection_policy_id",
              "operation_order",
              "projected_source_snapshot_count",
              "delivery_candidate_snapshot_count",
              "selection_stride",
              "interpolation",
              "equivalence_claim",
              "projected_then_selected_indices_match_sampling_proposal",
              "delivery_candidate_materialized",
              "policy_approved",
              "renderer_native_input_emitted"
            ],
            "properties": {
              "state": {
                "const": "PROPOSED_NOT_APPROVED_NOT_FROZEN"
              },
              "proposal_contract_sha256": {
                "const": "72aa659dfc464ce8f2205cc483c18cdff96b82e55f3651102310f9f83ce897b4"
              },
              "coordinate_projection_policy_id": {
                "const": "C11D_CHALLENGE_COORDINATE_PROJECTION_1080_TO_540_TO_REVIEW720_V1"
              },
              "sample_selection_policy_id": {
                "const": "C11D_CHALLENGE_SAMPLE_EVERY_SECOND_SOURCE_SNAPSHOT_NO_INTERPOLATION_V1"
              },
              "operation_order": {
                "const": [
                  "PROJECT_ALL_GAME_COORDINATES_IN_ORIGINAL_ORDER",
                  "SELECT_EVEN_ZERO_BASED_GAME_LOCAL_INDICES"
                ]
              },
              "projected_source_snapshot_count": {
                "const": 420
              },
              "delivery_candidate_snapshot_count": {
                "const": 210
              },
              "selection_stride": {
                "const": 2
              },
              "interpolation": {
                "const": "NONE"
              },
              "equivalence_claim": {
                "const": "DECLARED_FOR_AFFINE_UNIFORM_TRANSFORM_ONLY"
              },
              "projected_then_selected_indices_match_sampling_proposal": {
                "const": true
              },
              "delivery_candidate_materialized": {
                "const": false
              },
              "policy_approved": {
                "const": false
              },
              "renderer_native_input_emitted": {
                "const": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "content_type": {
                  "const": "challenges"
                }
              },
              "required": [
                "content_type"
              ]
            },
            "then": {
              "required": [
                "sample_selection",
                "coordinate_sample_composition"
              ]
            }
          }
        ]
      }
    },
    "harness_evidence": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "name",
          "script",
          "script_sha256",
          "exit_code",
          "summary_sha256",
          "pass_marker_seen",
          "runtime_error_log_seen"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "exit_code": {
            "const": 0
          },
          "summary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pass_marker_seen": {
            "const": true
          },
          "runtime_error_log_seen": {
            "const": false
          },
          "script_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "cross_artifact_checks": {
      "type": "object",
      "required": [
        "c11c_manifest_identity",
        "challenge_source_identity",
        "payload_repeat_determinism",
        "profile_identity_parity",
        "delivery_timeline_parity",
        "field_window_parity",
        "simulation_invariance",
        "governance_boundary",
        "challenge_visual_payload_identity",
        "coordinate_projection_parity",
        "challenge_sample_selection_proposal_parity",
        "challenge_coordinate_sample_composition_proposal_parity"
      ],
      "properties": {
        "c11c_manifest_identity": {
          "const": true
        },
        "challenge_source_identity": {
          "const": true
        },
        "payload_repeat_determinism": {
          "const": true
        },
        "profile_identity_parity": {
          "const": true
        },
        "delivery_timeline_parity": {
          "const": true
        },
        "field_window_parity": {
          "const": true
        },
        "simulation_invariance": {
          "const": true
        },
        "governance_boundary": {
          "const": true
        },
        "challenge_visual_payload_identity": {
          "const": true
        },
        "coordinate_projection_parity": {
          "const": true
        },
        "challenge_sample_selection_proposal_parity": {
          "const": true
        },
        "challenge_coordinate_sample_composition_proposal_parity": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "unresolved_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_state": {
      "type": "object"
    },
    "execution_boundary": {
      "type": "object",
      "required": [
        "persistent_report_written",
        "payload_files_written",
        "renderer_native_input_emitted",
        "renderer_dispatch_invoked",
        "renderer_activation",
        "production_execution",
        "media_created",
        "c11c_source_mutation",
        "video_render_ready",
        "d4_8",
        "release_authority"
      ],
      "properties": {
        "persistent_report_written": {
          "const": false
        },
        "payload_files_written": {
          "const": false
        },
        "renderer_native_input_emitted": {
          "const": false
        },
        "renderer_dispatch_invoked": {
          "const": false
        },
        "renderer_activation": {
          "const": false
        },
        "production_execution": {
          "const": false
        },
        "media_created": {
          "const": false
        },
        "c11c_source_mutation": {
          "const": false
        },
        "video_render_ready": {
          "const": false
        },
        "d4_8": {
          "const": "BLOCKED"
        },
        "release_authority": {
          "const": "NONE"
        }
      },
      "additionalProperties": true
    },
    "review_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
