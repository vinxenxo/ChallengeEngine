  "source_semantics": {
    "fps_authority": "ACTUAL_RENDERED_FRAME_STREAM_FPS",
    "pre_roll_frames": "round(COUNTDOWN_SECONDS * fps)",
    "game_payload_frames": "actual_runtime_get_frame_count",
    "end_cta_frames": "round(END_CTA_SECONDS * fps)",
    "total_final_frames": "pre_roll_frames + game_payload_frames + end_cta_frames",
    "player_frame_index_contract": {
      "PRE_ROLL": "global presentation frame index, from 0 to pre_roll_frames-1",
      "GAME": "local current gameplay frame index, from 0 to game_payload_frames-1; player passes _current_frame_index to binder",
      "END_CTA": "global presentation frame index, from pre_roll_frames+game_payload_frames to total_final_frames-1"
    }
  },
  "candidate_mapping": {
    "formula": "final_presentation_frame_index = pre_roll_frames + game_payload_frame_index",
    "pre_roll_frames": "round(3.0 * actual_stream_fps)",
    "end_cta_frames": "round(3.0 * actual_stream_fps)",
    "game_payload_interval": "[0, actual_game_payload_frame_count)",
    "final_game_interval": "[pre_roll_frames, pre_roll_frames + actual_game_payload_frame_count)",
    "phase_visibility": {
      "PRE_ROLL": "SUPPRESS_ALL_D_EDITORIAL_FIELDS",
      "GAME": "APPLY_A3_NONEMPTY_FIELDS_WITH_EXACT_GAME_PAYLOAD_TO_FINAL_FRAME_MAPPING",
      "END_CTA": "SUPPRESS_ALL_D_EDITORIAL_FIELDS; preserve native C11-C END_CTA header CTA",
      "DONE": "NO_FRAME"
    },
    "source_frame_mapping": {
      "PRE_ROLL": "reuse source frame index 0, matching existing C11-C player",
      "GAME": "source frame index equals game_payload_frame_index",
      "END_CTA": "reuse source frame index game_payload_frame_count - 1, matching existing C11-C player"
    },
    "frame_rate": "UNCHANGED_ACTUAL_STREAM_FPS",
    "frame_order": "IDENTITY_WITH_PHASE_INSERTION_ALREADY_PERFORMED_BY_C11C_PLAYER",
    "frame_count": "PRESERVE_C11C_TOTAL_PRESENTATION_FRAMES; NO_RESAMPLING_OR_DUPLICATE_OFFSET",
    "a3_field_window_convention": "ZERO_BASED_HALF_OPEN_GAME_PAYLOAD_INTERVAL"
  },
  "worked_example": {
    "fps": 30,
    "game_payload_frames": 630,
