{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c11d:renderer-dynamic-request-payload-input:v2",
  "title": "C11-D dynamic request payload input schema V2 — Visual Drill selector/tier extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "request_id",
    "request_hash",
    "selection",
    "seed",
    "music_seed",
    "variation_index",
    "presentation_profile_id",
    "delivery_profile_id"
  ],
  "properties": {
    "schema": {
      "const": "C11-D-D9-DYNAMIC-REQUEST-PAYLOAD-INPUT-V2"
    },
    "schema_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_type",
            "family_id",
            "subtype_id",
            "variant_id"
          ],
          "properties": {
            "content_type": {
              "const": "visual_drills"
            },
            "family_id": {
              "const": "peripheral_scan"
            },
            "subtype_id": {
              "type": "null"
            },
            "variant_id": {
              "enum": [
                "tier-1",
                "tier-2",
                "tier-3",
                "tier-4",
                "tier-5"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_type",
            "family_id",
            "subtype_id",
            "variant_id"
          ],
          "properties": {
            "content_type": {
              "const": "visual_drills"
            },
            "family_id": {
              "const": "pursuit"
            },
            "subtype_id": {
              "type": "null"
            },
            "variant_id": {
              "enum": [
                "tier-1",
                "tier-2",
                "tier-3",
                "tier-4",
                "tier-5"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_type",
            "family_id",
            "subtype_id",
            "variant_id"
          ],
          "properties": {
            "content_type": {
              "const": "visual_drills"
            },
            "family_id": {
              "const": "saccade"
            },
            "subtype_id": {
              "type": "null"
            },
            "variant_id": {
              "enum": [
                "tier-1",
                "tier-2",
                "tier-3",
                "tier-4",
                "tier-5"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_type",
            "family_id",
            "subtype_id",
            "variant_id"
          ],
          "properties": {
            "content_type": {
              "const": "visual_drills"
            },
            "family_id": {
              "const": "tracking"
            },
            "subtype_id": {
              "type": "null"
            },
            "variant_id": {
              "enum": [
                "tier-1",
                "tier-2",
                "tier-3",
                "tier-4",
                "tier-5"
              ]
            }
          }
        }
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "music_seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "variation_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "presentation_profile_id": {
      "const": "social_default_v1"
    },
    "delivery_profile_id": {
      "enum": [
        "REVIEW_720",
        "MIN_540",
        "MASTER_1080",
        "META_REELS_FINAL_V1"
      ]
    }
  }
}
