{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c11d:renderer-candidate-logical-composition:v1",
  "title": "C11-D Renderer Candidate Logical Composition Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "status", "contract_identity", "implementation_identity",
    "source_identity", "content_identity", "canvas_target", "localization", "text_elements",
    "seed_isolation", "truth_and_telemetry", "execution_boundary", "composition_sha256"
  ],
  "properties": {
    "schema": {"const": "C11-D-D9-LOGICAL-COMPOSITION-PLAN-V1"},
    "schema_version": {"const": "1.0"},
    "status": {"const": "PREPARATION_ONLY_LOGICAL_SCENE_NOT_RENDERER_INPUT"},
    "contract_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "sha256", "output_schema_sha256", "binding_preview_contract_sha256"],
      "properties": {
        "schema": {"const": "C11-D-RENDERER-CANDIDATE-LOGICAL-COMPOSITION-CONTRACT-V1"},
        "schema_version": {"const": "1.0"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "output_schema_sha256": {"$ref": "#/$defs/sha256"},
        "binding_preview_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "implementation_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "version", "sha256"],
      "properties": {
        "module": {"const": "tools/c11d/d9/d_renderer_logical_composition.py"},
        "version": {"const": "0.2.0-preparation"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["request_hash", "editorial_hash", "plan_hash", "bridge_record_hash", "adapter_envelope_hash", "binding_preview_sha256"],
      "properties": {
        "request_hash": {"$ref": "#/$defs/sha256"},
        "editorial_hash": {"$ref": "#/$defs/sha256"},
        "plan_hash": {"$ref": "#/$defs/sha256"},
        "bridge_record_hash": {"$ref": "#/$defs/sha256"},
        "adapter_envelope_hash": {"$ref": "#/$defs/sha256"},
        "binding_preview_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "content_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["content_type", "family_id", "subtype_id", "variant_id", "variant_scope_id", "difficulty_tier"],
      "properties": {
        "content_type": {"enum": ["challenges", "visual_loops", "visual_drills"]},
        "family_id": {"type": "string"},
        "subtype_id": {"type": ["string", "null"]},
        "variant_id": {"type": ["string", "null"]},
        "variant_scope_id": {"type": "string"},
        "difficulty_tier": {"type": ["integer", "null"]}
      }
    },
    "canvas_target": {
      "type": "object", "additionalProperties": false,
      "required": ["delivery_profile_requested_id", "delivery_profile_resolved_id", "width", "height", "aspect_ratio", "fps", "pixel_format", "canvas_semantics"],
      "properties": {
        "delivery_profile_requested_id": {"type": "string"},
        "delivery_profile_resolved_id": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "aspect_ratio": {"type": "string"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "pixel_format": {"type": ["string", "null"]},
        "canvas_semantics": {"const": "DELIVERY_TARGET_ONLY_NOT_CAPTURE_OR_RENDER_AUTHORIZATION"}
      }
    },
    "localization": {
      "type": "object", "additionalProperties": false,
      "required": ["locale", "applies_to_all_text_elements", "source_field", "source_value_sha256"],
      "properties": {
        "locale": {"type": "string", "minLength": 1},
        "applies_to_all_text_elements": {"const": true},
        "source_field": {"const": "language"},
        "source_value_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "text_elements": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["element_id", "semantic_role", "target_region", "z_order", "source_field", "source_preview_slot_id", "target_mapping_state", "text_value", "text_sha256", "language", "content_binding"],
        "properties": {
          "element_id": {"type": "string", "minLength": 1},
          "semantic_role": {"enum": ["HEADER_TITLE", "HEADER_SUBTITLE", "FOOTER_CALL_TO_ACTION", "CHALLENGE_PLAYER_NAME", "CHALLENGE_LABEL"]},
          "target_region": {"enum": ["HEADER", "FOOTER", "CHALLENGE_OVERLAY"]},
          "z_order": {"type": "integer", "minimum": 0},
          "source_field": {"enum": ["title", "subtitle", "call_to_action", "player_name", "challenge_label"]},
          "source_preview_slot_id": {"type": "string", "minLength": 1},
          "target_mapping_state": {"const": "PROPOSED_NOT_APPROVED"},
          "text_value": {"type": "string", "minLength": 1},
          "text_sha256": {"$ref": "#/$defs/sha256"},
          "language": {"type": "string", "minLength": 1},
          "content_binding": {"const": "DIRECT_CANONICAL_EDITORIAL_VALUE"}
        }
      }
    },
    "seed_isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["gameplay_seed_source", "gameplay_seed_domain", "music_seed_source", "music_seed_domain", "cross_domain_seed_sharing", "scene_elements_seed_derived", "audio_rendered"],
      "properties": {
        "gameplay_seed_source": {"const": "canonical_request.seed"},
        "gameplay_seed_domain": {"const": "GAMEPLAY"},
        "music_seed_source": {"const": "canonical_request.music_seed"},
        "music_seed_domain": {"const": "MUSIC"},
        "cross_domain_seed_sharing": {"const": "FORBIDDEN"},
        "scene_elements_seed_derived": {"const": false},
        "audio_rendered": {"const": false}
      }
    },
    "truth_and_telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["simulation_truth", "derived_telemetry"],
      "properties": {"simulation_truth": {"const": "NOT_BOUND"}, "derived_telemetry": {"const": "NOT_BOUND"}}
    },
    "execution_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["composition_mode", "renderer_input_emitted", "renderer_dispatch_invoked", "renderer_activation", "production_execution", "media_output_created", "output_artifact_path", "d4_8", "release_authority", "c11c_source_mutation"],
      "properties": {
        "composition_mode": {"const": "IN_MEMORY_SEMANTIC_REVIEW_ONLY"},
        "renderer_input_emitted": {"const": false},
        "renderer_dispatch_invoked": {"const": false},
        "renderer_activation": {"const": false},
        "production_execution": {"const": false},
        "media_output_created": {"const": false},
        "output_artifact_path": {"type": "null"},
        "d4_8": {"const": "BLOCKED"},
        "release_authority": {"const": "NONE"},
        "c11c_source_mutation": {"const": false}
      }
    },
    "composition_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
