{
  "schema": "C11-D-D9-SHARED-PRODUCTION-CONTEXT-FACADE-CONTRACT-V1",
  "schema_version": "1.0",
  "status": "PREPARE_ONLY_COMMON_BACKEND_FACADE_NOT_RENDERER_INPUT",
  "purpose": "Provide one reusable D9 backend operation for future GUI and CLI callers. It composes the canonical D9.9 planner, D9.10 bridge, D-owned prepare-only adapter and shared editorial/presentation context binding without duplicating resolution logic or enabling rendering.",
  "interface": {
    "python_api": "prepare_shared_production_context(raw_request, project_root=None)",
    "record_validator": "validate_shared_production_context(record, raw_request, project_root=None)",
    "cli_entrypoint": "tools/c11d/d9/shared_production_context_cli.py",
    "gui_contract": "GUI calls the same Python API; no GUI-specific editorial or presentation resolution path is permitted",
    "cli_protocol": "UTF-8 JSON on stdout; ASCII-safe JSON serialization; input request is read-only; no output-path argument",
    "result_persistence": "NONE"
  },
  "composition_order": [
    {
      "step": 1,
      "authority": "D9.9",
      "operation": "evaluate_universal_request"
    },
    {
      "step": 2,
      "authority": "D9.10",
      "operation": "build_bridge_planning_record"
    },
    {
      "step": 3,
      "authority": "D_RENDER_ADAPTER",
      "operation": "prepare_d_only_adapter_envelope"
    },
    {
      "step": 4,
      "authority": "D9_SHARED_CONTEXT",
      "operation": "build_context_binding_from_result"
    },
    {
      "step": 5,
      "authority": "D9_SHARED_CONTEXT",
      "operation": "validate_binding_record"
    },
    {
      "step": 6,
      "authority": "D_FACADE",
      "operation": "cross_component_identity_and_governance_check"
    }
  ],
  "supported_content_types": [
    "challenges",
    "visual_loops",
    "visual_drills"
  ],
  "binding_invariants": {
    "single_canonical_request_plan": true,
    "same_request_plan_editorial_hashes_across_components": true,
    "presentation_profile_must_be_registered": true,
    "editorial_model_is_single_source_of_truth": true,
    "shared_editorial_presentation_inherited_by_default": true,
    "family_adapters_cannot_mutate_shared_editorial_values": true,
    "unknown_content_type_or_profile": "REJECT",
    "unknown_family_or_variant": "REJECT_BY_CANONICAL_D9_9",
    "gameplay_music_seed_cross_domain_sharing": "FORBIDDEN",
    "service_output_in_memory_only": true,
    "gui_cli_parity": "EXACT_CANONICAL_RECORD_EQUALITY"
  },
  "output": {
    "schema": "C11-D-D9-SHARED-PRODUCTION-CONTEXT-FACADE-V1",
    "contains": [
      "canonical_result",
      "bridge_planning_record",
      "d_only_adapter_envelope",
      "shared_context_binding"
    ],
    "renderer_native_input_emitted": false,
    "renderer_dispatch_invoked": false,
    "media_created": false,
    "persisted": false
  },
  "governance": {
