{
  "model_id": "C11D_UNIVERSAL_EDITORIAL_MODEL",
  "schema": "C11-D-D9-UNIVERSAL-EDITORIAL-MODEL-V1",
  "schema_version": "1.0",
  "checkpoint": "D9.8",
  "status": "CANONICAL_DECLARATIVE_MODEL",
  "purpose": "Define one content-aware editorial model for the existing C11-D branch without conflating editorial values with telemetry, provenance, simulation truth, seed governance, or production authority.",
  "authority": {
    "runtime_authority": "NONE",
    "renderer_activation": false,
    "production_execution": false,
    "release_authority": "NONE",
    "canonical_request_plan_identity_owner": "tools/c11d/d4 canonical request/personalization/plan adapters",
    "producer_gui_integration": "D9.9",
    "physical_editorial_to_media_materialization": "D9.10_BRIDGE_PLANNING_ONLY; PHYSICAL_MATERIALIZATION_DEFERRED_UNTIL_FUTURE_C11-D_FROZEN_BASELINE",
    "frozen_c11c_renderer_mutation": "FORBIDDEN"
  },
  "source_of_truth": {
    "producer_inventory": "c11c-suite/c11c-producer/producer_schema.json",
    "challenge_details": "challenges/CHALLENGE_*.json",
    "personalization_profile_registry": "definitions/c11d/personalization/C11D_PERSONALIZATION_PROFILE_REGISTRY_V1.json",
    "current_d4_request_contract": "definitions/c11d/production/C11D_PRODUCTION_REQUEST_SCHEMA_V1.json",
    "resolution_policy": "Read current registries; never duplicate or silently rename their identities in this model."
  },
  "operator_selection_path": [
    "content_type",
    "family_id (when declared)",
    "subtype_id / grammar / drill type (when declared)",
    "variant_id (when declared)",
    "editorial profile",
    "individual production override"
  ],
  "inheritance_order": [
    "global",
    "content_type",
    "family",
    "subtype",
    "variant",
    "production_override"
  ],
  "inheritance_policy": {
    "merge": "later applicable layer overrides earlier value",
    "unknown_fields": "REJECT",
    "unknown_selection": "REJECT",
    "unsupported_content_type": "REJECT_FOR_ACTIVE_RESOLUTION",
    "no_silent_fallback": "true",
    "empty_optional_string": "NORMALIZE_TO_UNKNOWN",
    "strings": "TRIM",
    "language": "LOWERCASE_AFTER_TRIM",
    "max_string_length": 160,
    "explicit_empty_does_not_delete_higher_layer": "EMPTY_NORMALIZES_TO_UNKNOWN",
    "global_layer_fields": [
      "title",
      "subtitle",
      "call_to_action",
      "language"
    ]
  },
  "editorial_fields": {
    "title": {
      "type": "string",
      "enabled": true,
      "content_types": [
        "challenges",
        "visual_loops",
        "visual_drills"
