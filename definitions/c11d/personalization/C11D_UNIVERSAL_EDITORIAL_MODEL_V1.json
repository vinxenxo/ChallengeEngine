  "data_classes": {
    "editable_editorial": {
      "meaning": "Human-authored text/visibility values explicitly allowlisted by the selected content type.",
      "editable_keys": [
        "title",
        "subtitle",
        "call_to_action",
        "language",
        "player_name",
        "challenge_label"
      ]
    },
    "derived_telemetry": {
      "editable": false,
      "fields": [
        "seed",
        "music_seed",
        "fps",
        "duration_seconds",
        "frame_count",
        "palette_name",
        "palette_id",
        "system_id",
