  "content_types": {
    "challenges": {
      "operator_label": "Challenge",
      "model_state": "ACTIVE",
      "request_plan_compatibility": "CURRENT_D4_CHALLENGE_REQUEST_ONLY",
      "inventory": {
        "source": "c11c-suite/c11c-producer/producer_schema.json",
        "collection": "challenges",
        "id_field": "id",
        "family_field": "mechanic",
        "subtype_field": null
      },
      "selection": {
        "family_is_derived_from": "mechanic",
        "variant_is": "challenge_id",
        "subtype_required": false
      },
      "editable_fields": [
        "title",
        "subtitle",
        "call_to_action",
        "language",
        "player_name",
        "challenge_label"
      ],
      "profile_id": "editorial_text_v1"
    },
    "visual_loops": {
      "operator_label": "Visual Loop",
      "model_state": "ACTIVE_MODEL_ONLY",
      "request_plan_compatibility": "PENDING_D9_9_UNIVERSAL_REQUEST_ADAPTER",
      "inventory": {
        "source": "c11c-suite/c11c-producer/producer_schema.json",
        "collection": "families",
        "family_id": "dictionary_key",
        "family_label": "name",
        "subtype_collection": "grammars",
        "subtype_id_index": 0,
        "subtype_label_index": 1,
        "selector_modes": [
          "auto"
        ],
        "selector_modes_are_concrete_grammars": false
      },
      "selection": {
        "family_required": true,
        "subtype_required": true,
        "variant_scope_identity": "family_id/subtype_id",
        "additional_native_variant_registry": "NOT_DECLARED_IN_CURRENT_PRODUCER_SCHEMA"
      },
      "editable_fields": [
        "title",
        "subtitle",
        "call_to_action",
        "language"
      ],
      "technical_generator_parameters": "NOT_EDITORIAL; remain on existing C11-C Producer surface"
    },
    "visual_drills": {
      "operator_label": "Visual Drill",
      "model_state": "ACTIVE_MODEL_ONLY",
      "request_plan_compatibility": "PENDING_D9_9_UNIVERSAL_REQUEST_ADAPTER",
      "inventory": {
        "source": "c11c-suite/c11c-producer/producer_schema.json",
        "collection": "drills",
        "family_id": "dictionary_key",
        "family_label": "name",
        "variant_collection": "difficulty_values",
        "variant_id_pattern": "tier-{difficulty}"
      },
      "selection": {
        "family_required": true,
        "subtype_required": false,
        "variant_required": true,
        "variant_is": "explicit difficulty tier from current producer schema"
      },
      "editable_fields": [
        "title",
        "subtitle",
        "call_to_action",
        "language"
      ],
      "difficulty_tier": "DERIVED_VARIANT_SELECTOR_NOT_AN_EDITORIAL_FIELD"
    },
    "longform": {
      "operator_label": "Longform",
      "model_state": "VISIBLE_BUT_DISABLED",
      "request_plan_compatibility": "NOT_SUPPORTED_BY_CURRENT_D4_REQUEST_SCHEMA",
      "enabled_for_selection": false,
      "inventory": null,
      "editable_fields": [],
      "reason": "Longform is not a current producer_schema.video_types entry and the current D4 request requires challenge_id. LONGFORM_1080 is only a delivery profile and is not proof that Longform is a supported D content type."
    }
