# =============================
# ChallengeEngineV01_STATELESS
# Git hygiene / generated state
# =============================

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# Godot generated state
.godot/
.mono/
.import/
**/.import/
*.import
*.uid
**/*.uid
export.cfg
export_credentials.cfg
.godot_backups/
mono_crash.*.json
*.translation

# Python generated state
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Local environment / secrets
.env
.env.*
!.env.example
*.local

# Temporary / editor / crash files
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.old
*.orig
crash*.log

# Local shell history / personal command logs
ConsoleHost_history.txt

# Archives / local packages
*.zip
*.7z
*.rar

# =============================
# Generated binary artifacts
# Only under the canonical artifact root.
# Source/reference media elsewhere remains trackable.
# =============================
artifacts/**/*.avi
artifacts/**/*.mp4
#artifacts/**/*.gif
artifacts/**/*.pcm
artifacts/**/*.wav
#artifacts/**/*.png
#artifacts/**/*.jpg
artifacts/**/*.jpeg
artifacts/**/*.webp
artifacts/**/frames/
artifacts/**/avi/
artifacts/**/mp4/
#artifacts/**/gif/
artifacts/**/media/
artifacts/**/videos/
artifacts/

# Explicitly disposable workspace
artifacts/scratch/
