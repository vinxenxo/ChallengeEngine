+func _c6_variant_equivalent(a: Variant, b: Variant, path: String, failures: Array[String]) -> bool:
+	var ta: int = typeof(a)
+	var tb: int = typeof(b)
+	if ta == TYPE_INT or ta == TYPE_FLOAT:
+		if tb != TYPE_INT and tb != TYPE_FLOAT:
+			failures.append("%s: numeric type mismatch" % path)
+			return false
+		if abs(float(a) - float(b)) > 0.000001:
+			failures.append("%s: %.9f != %.9f" % [path, float(a), float(b)])
+			return false
+		return true
+	if ta != tb:
+		failures.append("%s: type %d != %d" % [path, ta, tb])
+		return false
+	match ta:
+		TYPE_VECTOR2:
+			if a.distance_to(b) > 0.000001:
+				failures.append("%s: Vector2 %s != %s" % [path, str(a), str(b)])
+				return false
+			return true
+		TYPE_ARRAY:
+			if a.size() != b.size():
+				failures.append("%s: array size %d != %d" % [path, a.size(), b.size()])
+				return false
+			for i in range(a.size()):
+				if not _c6_variant_equivalent(a[i], b[i], "%s[%d]" % [path, i], failures):
+					return false
+			return true
+		TYPE_DICTIONARY:
+			if a.size() != b.size():
+				failures.append("%s: dictionary size %d != %d" % [path, a.size(), b.size()])
+				return false
+			for key in a.keys():
+				if not b.has(key):
+					failures.append("%s: missing key '%s'" % [path, str(key)])
+					return false
+				if not _c6_variant_equivalent(a[key], b[key], "%s.%s" % [path, str(key)], failures):
+					return false
+			return true
+		_:
+			if a != b:
+				failures.append("%s: %s != %s" % [path, str(a), str(b)])
+				return false
+			return true
+
+func verify_shadow_equivalence(c6_ctx: ChallengeRuntimeContext) -> void:
+	print("[C6_SHADOW_EQUIVALENCE] Iniciando verificación estricta...")
+	if c6_ctx == null or c6_ctx.simulation_result == null or c6_ctx.timeline == null or c6_ctx.presentation_binding == null:
+		emit_engine_error("SHADOW_FAILED", "Contexto C6 incompleto. No se completó la tubería nueva.", "")
+		get_tree().quit(1)
+		return
+	var legacy_sim: SimulationResult = final_result
+	var legacy_tl: VideoTimeline = timeline
+	var c6_sim: SimulationResult = c6_ctx.simulation_result
+	var c6_tl: VideoTimeline = c6_ctx.timeline
+	var failures: Array[String] = []
+	if legacy_tl.fps != c6_tl.fps: failures.append("Timeline fps mismatch: %d vs %d" % [legacy_tl.fps, c6_tl.fps])
+	if legacy_tl.hook_frames != c6_tl.hook_frames: failures.append("Timeline hook_frames mismatch: %d vs %d" % [legacy_tl.hook_frames, c6_tl.hook_frames])
+	if legacy_tl.game_frames != c6_tl.game_frames: failures.append("Timeline game_frames mismatch: %d vs %d" % [legacy_tl.game_frames, c6_tl.game_frames])
+	if legacy_tl.reveal_frames != c6_tl.reveal_frames: failures.append("Timeline reveal_frames mismatch: %d vs %d" % [legacy_tl.reveal_frames, c6_tl.reveal_frames])
+	if legacy_tl.cta_frames != c6_tl.cta_frames: failures.append("Timeline cta_frames mismatch: %d vs %d" % [legacy_tl.cta_frames, c6_tl.cta_frames])
+	if legacy_tl.total_frames != c6_tl.total_frames: failures.append("Timeline total_frames mismatch: %d vs %d" % [legacy_tl.total_frames, c6_tl.total_frames])
+	if legacy_sim.winning_frame != c6_sim.winning_frame: failures.append("Simulation winning_frame mismatch: Legacy %d vs C6 %d" % [legacy_sim.winning_frame, c6_sim.winning_frame])
+	if legacy_sim.frames.size() != c6_sim.frames.size(): failures.append("Simulation frame count mismatch: Legacy %d vs C6 %d" % [legacy_sim.frames.size(), c6_sim.frames.size()])
+	if failures.is_empty():
+		for i in range(legacy_sim.frames.size()):
+			var lf: FrameSnapshot = legacy_sim.frames[i]
+			var cf: FrameSnapshot = c6_sim.frames[i]
+			if not _c6_variant_equivalent(lf.position, cf.position, "frame[%d].position" % i, failures): break
+			if not _c6_variant_equivalent(lf.rotation, cf.rotation, "frame[%d].rotation" % i, failures): break
+			if not _c6_variant_equivalent(lf.scale, cf.scale, "frame[%d].scale" % i, failures): break
+			if not _c6_variant_equivalent(lf.opacity, cf.opacity, "frame[%d].opacity" % i, failures): break
+			if not _c6_variant_equivalent(lf.custom_data, cf.custom_data, "frame[%d].custom_data" % i, failures): break
+	if not failures.is_empty():
+		emit_engine_error("SHADOW_EQUIVALENCE_FAILED", "Discrepancia detectada en Shadow Integration: " + " | ".join(failures), "")
+		get_tree().quit(1)
+		return
+	print("[C6_SHADOW_EQUIVALENCE] PASS — runtime legacy y pipeline C6 son equivalentes.")
 
 
